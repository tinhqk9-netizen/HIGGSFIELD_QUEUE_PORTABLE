# ==============================================================================
# VIDEO ANALYZER PIPELINE - MAU CAU HINH
# Chep file nay thanh `.env` roi dien gia tri. TUYET DOI KHONG commit file `.env`.
# ==============================================================================

# --- LLM / Vision provider (endpoint kieu OpenAI: 9Router, OpenAI, OpenRouter, vLLM...) ---
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1

# BAT BUOC dien. De trong o day la co y - khong bao gio commit key that.
NINE_ROUTER_API_KEY=

# Ten model theo ALIAS khai trong 9Router cua may ban. Hai ten duoi la alias
# may goc dang dung; neu 9Router cua ban khong co thi phai doi cho khop,
# khong thi toan bo buoc AI se loi.
VISION_MODEL=aa
TEXT_MODEL=ag/gemini-3.8-flash
NINE_ROUTER_TIMELINE_MODEL=aa

# Hoac dung thang OpenAI:
# NINE_ROUTER_BASE_URL=https://api.openai.com/v1
# NINE_ROUTER_API_KEY=
# VISION_MODEL=gpt-4o-mini
# TEXT_MODEL=gpt-4o-mini

# --- Whisper (nhan dang giong noi) ---
# tiny | base | small | medium | large | turbo
WHISPER_MODEL=base
# cuda = GPU NVIDIA, cpu = khong co GPU
WHISPER_DEVICE=cuda
# May khong co GPU PHAI bat cai nay, khong worker se khong khoi dong
ALLOW_CPU_FALLBACK=false

# --- Trich xuat khung hinh ---
FRAME_INTERVAL=0.5
FRAME_MAX_WIDTH=1280
FRAME_JPEG_QUALITY=3

# --- So video phan tich SONG SONG ---
WORKER_CONCURRENCY=5
